# Copy this file to .env.local. Never commit real keys.
OPENAI_API_KEY=
OPENAI_IMAGE_IMPORT_MODEL=gpt-5.6-terra

# Generate a key for the matching Demo or Live account with only account-data
# and portfolio read permissions. Do not grant order placement permissions.
TRADING212_API_KEY=
TRADING212_API_SECRET=
TRADING212_ENVIRONMENT=demo
PORTFOLIO_DB_FILENAME=invest-assets-monitor.sqlite

# Optional, on-demand portfolio narrative. Keys remain server-side and the app
# sends only the aggregate Portfolio insights facts when Generate is selected.
OPENAI_NARRATIVE_MODEL=gpt-5.6-terra

# Optional, on-demand bounded Portfolio Agent. It reuses the same server-side
# OpenAI key. The dedicated model setting falls back to the Narrative model.
OPENAI_ANALYST_MODEL=gpt-6-luna
OPENAI_IMAGE_QUESTION_MODEL=gpt-5.6-terra

# Optional model override for the official-source External market watch.
# Falls back to the OpenAI Analyst model, then the Narrative model.
OPENAI_MARKET_INTELLIGENCE_MODEL=gpt-5.6-terra
